# ============================================================
# DigiID Verify Blockchain — Environment Variables Template
# Copy this file to .env and fill in your actual values
# ============================================================

# Your Alchemy / Infura RPC endpoint (e.g. Sepolia or Polygon Amoy)
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
# For local development with Hardhat node, use http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Your wallet private key (the deployer / contract owner account)
# Must have testnet ETH / MATIC for gas fees when deploying to testnet.
# For local dev: Account #0 key printed by `npx hardhat node`
# Accepts both raw hex (64 chars) or 0x-prefixed (66 chars)
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
