{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/verify/(?<cert_id>[^/]+)",
      "dest": "/api/verify/$cert_id"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/admin",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/documents/anchor",
      "dest": "/api/documents/anchor.js"
    },
    {
      "src": "/api/documents/revoke",
      "dest": "/api/documents/revoke.js"
    },
    {
      "src": "/api/certificates/(?<identity_no>[^/]+)",
      "dest": "/api/certificates/index.js?identity_no=$identity_no"
    },
    {
      "src": "/api/documents",
      "dest": "/api/documents/index.js"
    },
    {
      "src": "/admin/styles.css",
      "dest": "/frontend/admin/styles.css"
    },
    {
      "src": "/admin/admin.js",
      "dest": "/frontend/admin/admin.js"
    },
    {
      "src": "/admin/login.html",
      "dest": "/frontend/admin/login.html"
    },
    {
      "src": "/admin/login",
      "dest": "/frontend/admin/login.html"
    },
    {
      "src": "/admin/index.html",
      "dest": "/frontend/admin/index.html"
    },
    {
      "src": "/admin/dashboard",
      "dest": "/frontend/admin/index.html"
    },
    {
      "src": "/admin/documents",
      "dest": "/frontend/admin/index.html"
    },
    {
      "src": "/admin/blockchain",
      "dest": "/frontend/admin/index.html"
    },
    {
      "src": "/admin/audit-logs",
      "dest": "/frontend/admin/index.html"
    },
    {
      "src": "/admin/settings",
      "dest": "/frontend/admin/index.html"
    },
    {
      "src": "/admin/?$",
      "dest": "/frontend/admin/login.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/frontend/admin/index.html"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
