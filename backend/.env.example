# ============================================================
# DigiID Verify — Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# ── Server ────────────────────────────────────────────────────
PORT=3000

# ── Database ──────────────────────────────────────────────────
# OPTION A (Cloud — Supabase / Neon / any cloud PostgreSQL):
#   Get your connection string from:
#   Supabase → Project Settings → Database → URI (Session mode / Transaction mode)
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# OPTION B (Local development — if DATABASE_URL is not set, these are used):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# ── Blockchain ────────────────────────────────────────────────
# RPC URL:
#   - Local dev:   http://127.0.0.1:8545  (run: cd blockchain && npx hardhat node)
#   - Sepolia:     https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
#   - Polygon Amoy: https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Private key of the wallet that will deploy + own the smart contract.
# For Sepolia/Amoy: This wallet needs testnet ETH/MATIC for gas fees.
# Accepts both raw hex (64 chars) or 0x-prefixed (66 chars) formats.
# For local dev: Use Account #0 printed by `npx hardhat node`.
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here

# ── Auth (Mock — replace with JWT secret when implementing real auth) ──
# This shared token protects the /api/certificates endpoints.
# On Render, set this to a long random string.
AUTH_TOKEN=digiid-secret
